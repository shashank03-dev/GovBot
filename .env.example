# Required backend credentials
WHATSAPP_TOKEN=replace-with-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=replace-with-whatsapp-verify-token
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-supabase-service-role-key
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_GENERATION_MODELS=gemini-2.5-flash,gemini-2.0-flash
TEXT_LLM_PROVIDERS_JSON=[{"name":"groq-1","provider":"groq","model":"llama-3.1-8b-instant","api_key_env":"GROQ_API_KEY_1","enabled":true,"weight":3},{"name":"mistral-1","provider":"mistral","model":"mistral-small-latest","api_key_env":"MISTRAL_API_KEY_1","enabled":true,"weight":2},{"name":"gemini-1","provider":"gemini","model":"gemini-2.5-flash","api_key_env":"GEMINI_API_KEY","enabled":true,"weight":1}]
GROQ_API_KEY_1=
MISTRAL_API_KEY_1=
SECRET_KEY=replace-with-a-32-character-secret
# Rotate these in production and keep them in your secret manager.
OFFICIAL_USERNAME=replace-with-official-username
OFFICIAL_PASSWORD=replace-with-official-password

# Common application settings
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
# Point both frontend URL vars at the public web app when the backend is exposed
# separately through ngrok or another public tunnel.
FRONTEND_URL=https://your-project.vercel.app
BASE_URL=https://your-project.vercel.app
CORS_ORIGINS=http://localhost:3000,https://your-project.vercel.app
SUPABASE_DOCUMENTS_BUCKET=user-documents
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# DigiLocker provider
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_API_KEY=
SETU_PRODUCT_ID=

# Bank verification provider
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
SANDBOX_ACCESS_TOKEN=

# Credential issuance and storage
ALCHEMY_API_KEY=
POLYGON_PRIVATE_KEY=
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com
CONTRACT_ADDRESS=
CREDENTIAL_CHAIN_NAME=Polygon Mumbai
CREDENTIAL_EXPLORER_BASE_URL=https://mumbai.polygonscan.com/tx/
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Mock-service toggles
# Production deployments should disable mocks and use the real provider credentials above.
MOCK_DIGILOCKER=false
MOCK_NPCI=false
