# Public Supabase config used by the dashboard pages.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=replace-with-supabase-anon-key

# Local defaults. For Vercel, set these in the project environment variables.
# Use the same ngrok backend URL for both vars so Next rewrites and browser-side
# fallbacks target the same backend during local previews.
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
# Server-side Next API proxy deadline in milliseconds. Increase only for slow
# document/OCR providers; most routes use 20s and OCR/document routes use 60s.
BACKEND_FETCH_TIMEOUT_MS=20000
